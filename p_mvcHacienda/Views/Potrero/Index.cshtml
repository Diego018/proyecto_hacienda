@using Bib_Hacienda.Clases
@model List<Potrero>

@{
    ViewData["Title"] = "Gestión de Potreros";
}

<div class="container mt-4">

    <div class="aw-page-header mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-1" style="color: var(--aw-text);">
                Gestión de Potreros
            </h1>
            <p class="text-muted mb-0">Administra los potreros de tu hacienda ganadera</p>
        </div>
        <a asp-action="Create" class="btn aw-btn aw-btn-primary shadow-sm">
            <span class="material-icons-outlined" style="font-size: 1.2rem; vertical-align: sub;">add</span>
            Crear Potrero
        </a>
    </div>

    @if (TempData["Mensaje"] != null) {
        <div class="alert alert-@TempData["TipoMensaje"] alert-dismissible fade show" role="alert">
            <strong>@TempData["Mensaje"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any()) {

        <div class="aw-card mt-3 aw-reveal" style="transition-delay: .4s;">
            <div class="p-3">
                <table class="table table-hover aw-table align-middle">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Tipo</th>
                            <th>Cantidad Reses</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var potrero in Model) {
                            <tr>
                                <td class="fw-semibold">@potrero.Identificacion</td>
                                <td>
                                    <span class="aw-badge aw-badge-secondary">@potrero.Tipo_potrero</span>
                                </td>
                                <td>@potrero.obtener_reses().Count</td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@potrero.Identificacion"
                                       class="btn btn-sm aw-btn aw-btn-secondary" title="Ver detalles">
                                        <span class="material-icons-outlined" style="font-size: 1rem; vertical-align: sub;">visibility</span>
                                        Detalles
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    } else {

        <div class="alert alert-warning text-center py-5 aw-card border-0 aw-reveal">
            <h3>No hay potreros registrados</h3>
            <p class="lead">Comienza creando tu primer potrero para gestionar tu hacienda</p>
            <a asp-action="Create" class="btn aw-btn aw-btn-primary btn-lg rounded-pill px-5 mt-3">
                Crear Primer Potrero
            </a>
        </div>

    }

</div>